{
  "problem": "add_two_integers",
  "statement": "problem.md",
  "time_limit_s": 1,
  "memory_limit_mb": 64,
  "sample_input": "7 5\n",
  "reference": "reference.c",
  "compile": { "cc": "gcc", "flags": "-O2 -std=c11", "ldflags": "-lm" },
  "metrics": [
    {
      "name": "correctness",
      "analyzer": "io_tests",
      "weight": 0.20,
      "params": { "testset_dir": "tests/" }
    },
    {
      "name": "syntax",
      "analyzer": "compiler_warnings",
      "weight": 0.10,
      "params": { "flags": "-Wall -Wextra -Werror -std=c11" }
    },
    {
      "name": "structure",
      "analyzer": "static_analysis",
      "weight": 0.10,
      "params": { "max_cyclomatic": 8, "max_function_length": 40 }
    },
    {
      "name": "modularity",
      "analyzer": "function_split",
      "weight": 0.10,
      "params": { "expect_helpers": true, "min_functions": 2 }
    },
    {
      "name": "logical",
      "analyzer": "edge_case_runner",
      "weight": 0.10,
      "params": { "cases": ["negatives", "zero", "int_overflow"],
                  "random_tests": 20, "sizes": [10, 1000, 2147483647], "seed": 7 }
    },
    {
      "name": "complexity",
      "analyzer": "complexity_estimator",
      "weight": 0.10,
      "params": { "required": "O(1)", "sizes": [1, 10, 100] }
    },
    {
      "name": "memory_safety",
      "analyzer": "sanitizer_run",
      "weight": 0.10,
      "params": { "flags": "-fsanitize=address,undefined" }
    },
    {
      "name": "readability",
      "analyzer": "llm_review",
      "weight": 0.10,
      "params": { "provider": "ollama", "model": "qwen2.5:7b", "temperature": 0, "seed": 42 }
    },
    {
      "name": "originality",
      "analyzer": "similarity_flag",
      "weight": 0.10,
      "params": { "corpus_dir": "submissions/", "known_dir": "known/", "flag_threshold": 0.85 }
    }
  ]
}
